{
  "uid": "seqtoid-support-inbox",
  "title": "seqtoid - Support Inbox",
  "tags": [
    "seqtoid",
    "support",
    "loki"
  ],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "Namespace",
        "query": "seqtoid-dev",
        "current": {
          "text": "seqtoid-dev",
          "value": "seqtoid-dev"
        },
        "options": [
          {
            "text": "seqtoid-dev",
            "value": "seqtoid-dev",
            "selected": true
          }
        ]
      },
      {
        "name": "ticket",
        "type": "textbox",
        "label": "Ticket (trace id)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Set automatically when you click a row; .* shows all tickets."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tickets (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\"} |= \"[support_request]\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tickets (24h)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\"} |= \"[support_request]\" [24h]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tickets (7d)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\"} |= \"[support_request]\" [7d]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Support queue  -  click any row to open its detail below",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"$namespace\"} |= \"[support_request]\" | regexp \"(?P<payload>\\\\{.*\\\\})\" | line_format \"{{ .payload }}\" | json submitted=\"submitted_at\", email=\"user_email\", role=\"user_role\", error=\"error\", task=\"task\", project=\"project\", account=\"account_name\", description=\"description\", summary=\"summary\", trace_id=\"correlation_id\", runbook_label=\"runbook.label\", runbook_url=\"runbook.runbook\", environment=\"environment\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "submitted",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true,
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          },
          "links": [
            {
              "title": "Show this ticket below (and scroll to Ticket detail)",
              "url": "/d/seqtoid-support-inbox/seqtoid-support-inbox?var-ticket=${__data.fields.trace_id}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "description"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 360
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "summary"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "email"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "submitted"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runbook_label"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open runbook",
                    "url": "${__data.fields.runbook_url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "keepLabels": [
              "submitted",
              "email",
              "role",
              "error",
              "task",
              "project",
              "account",
              "description",
              "summary",
              "trace_id",
              "runbook_label",
              "runbook_url",
              "environment"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "tsNs": true,
              "id": true,
              "labels": true,
              "Line": true,
              "__error__": true,
              "__error_details__": true,
              "runbook_url": true,
              "account": true,
              "summary": true
            },
            "indexByName": {
              "submitted": 0,
              "email": 1,
              "role": 2,
              "error": 3,
              "task": 4,
              "project": 5,
              "description": 6,
              "runbook_label": 7,
              "environment": 8,
              "trace_id": 9
            },
            "renameByName": {
              "trace_id": "trace id",
              "runbook_label": "runbook"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Ticket detail  -  expand the line for all fields + clickable links   (showing: $ticket)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"$namespace\"} |= \"[support_request]\" |~ \"$ticket\" | regexp \"(?P<payload>\\\\{.*\\\\})\" | line_format \"{{ .payload }}\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "type": "text",
      "title": "How to use / next steps",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "mode": "markdown",
        "content": "**Click any row** in the queue to load that ticket in **Ticket detail** below, then expand the log line to see every field (summary, journey, diagnostics) and click the runbook / CloudWatch / OTel links. Reset by setting the **Ticket** variable back to `.*`.\\n\\n*Deep-links resolve once `OTEL_DASHBOARD_BASE_URL` + `SUPPORT_LOG_GROUP` are set (#472). To assign / status / close tickets (not just view), route them to Jira or Forgejo (Option B) - Grafana is read-only.*"
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true
}